rules_version = '2';

// GENERATED by scripts/generate-firestore-rules.mjs. Do not edit by hand:
// update students.json / teachers.json and run `npm run rules`.
service cloud.firestore {
  match /databases/{database}/documents {
    function githubId() {
      return request.auth != null && 'github.com' in request.auth.token.firebase.identities
        ? request.auth.token.firebase.identities['github.com'][0]
        : '';
    }

    function isTeacher() {
      return githubId() in ['113380298'];
    }

    // GitHub id -> student id in students.json
    function myStudentId() {
      return {
        '200263057': 's1',
        '143524574': 's2',
        '191076515': 's3',
        '283659916': 's4',
        '221770287': 's5',
        '200413548': 's6',
        '200503293': 's7',
        '139025067': 's8',
        '324687222': 's9',
        '162861599': 's10',
        '200151677': 's11',
        '324197935': 's12',
        '320729434': 's13',
        '200547621': 's14',
        '189266158': 's15',
        '189269861': 's16',
        '323027280': 's17',
        '262938342': 's18',
        '200695912': 's19',
        '199984071': 's20',
        '81888965': 's21',
        '229668711': 's22',
        '324684323': 's23',
        '56488662': 's24',
        '180249219': 's25',
        '185731973': 's26',
        '324278345': 's27',
        '200164120': 's28',
        '205275722': 's29',
        '324726459': 's30',
        '277558358': 's31',
        '324920647': 's32',
        '200406039': 's33',
        '324919965': 's34',
        '199988840': 's35',
        '200867110': 's36',
        '217287249': 'std37',
        '199977943': 'std38',
        '144404760': 'std39'
      }.get(githubId(), '');
    }

    function isStudent() {
      return myStudentId() != '';
    }

    function ownsRecord() {
      return isStudent() && resource.data.studentId == myStudentId();
    }

    match /tasks/{taskId} {
      allow read: if isTeacher() || isStudent();
      allow write: if isTeacher();
    }

    match /attendance/{docId} {
      allow read: if isTeacher() || ownsRecord();
      allow write: if isTeacher();
    }

    match /grades/{docId} {
      allow read: if isTeacher() || ownsRecord();
      allow write: if isTeacher();
    }

    match /students/{studentId} {
      allow read, write: if isTeacher();
    }

    match /followups/{studentId} {
      allow read, write: if isTeacher();
    }

    match /evaluations/{teamId} {
      allow read, write: if isTeacher();
    }
  }
}
